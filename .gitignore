# Dependencies — playwright is only needed to run the verification scripts.
node_modules/

# Generated by scripts/verify.mjs and scripts/shots-help.mjs.
# Regenerate with the verification suite rather than committing binaries
# that change on every run.
verify-shots/

# OS / editor noise
Thumbs.db
.DS_Store
.vscode/
.idea/

# NOTE: img/ and data/ are NOT ignored. They are the application's content,
# extracted from the original single-file build, and the app is broken
# without them.

# Built by scripts/build-single.mjs — the whole site inlined into one file,
# 4 MB of it base64 screenshots. Regenerate it; do not commit a binary blob
# that changes wholesale whenever any source file moves by a byte.
dist/
